@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(@sengine_graphics@)
  include("${CMAKE_CURRENT_LIST_DIR}/filament.cmake")
  find_dependency(SDL3 3.2 CONFIG)
  if("@sengine_window_backend@" STREQUAL "glfw")
    find_dependency(glfw3 3.3)
  endif()
  find_dependency(Freetype)
  find_dependency(PNG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/sengine-targets.cmake")
